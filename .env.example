# Hugging Face token - required for gated models, recommended for rate limits.
# Create one at https://huggingface.co/settings/tokens (read scope is enough).
HF_TOKEN=hf_xxx

# API key clients must send as "Authorization: Bearer <key>".
# Leave blank to disable auth. setup.ps1 generates a random one for you.
LLAMA_API_KEY=

# Optional overrides. Defaults live in docker-compose.yml; run.ps1 sets these
# per invocation, so you rarely need to touch them here.
# MODEL_FILE=Qwen3.6-35B-A3B-UD-IQ4_XS.gguf
# CONTEXT_SIZE=262144
# REASONING=on
# LLAMA_IMAGE=ghcr.io/ggml-org/llama.cpp:server-cuda13
