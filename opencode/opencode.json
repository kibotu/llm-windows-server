{
  "$schema": "https://opencode.ai/config.json",
  "provider": {
    "llama-at-home": {
      "name": "Kira",
      "npm": "@ai-sdk/openai-compatible",
      "options": {
        "baseURL": "http://127.0.0.1:8899/v1",
        "apiKey": "sk-local",
        "timeout": 300000,
        "chunkTimeout": 120000
      },
      "models": {
        "qwen36-35b": {
          "name": "Qwen3.6-35B-A3B (Q4_K_M)",
          "limit": {
            "context": 131072,
            "output": 8000
          }
        },
        "Qwen3.5-9B": {
          "name": "Qwen3.5-9B",
          "limit": {
            "context": 128000,
            "output": 6000
          }
        }
      }
    }
  },
  "model": "llama-at-home/qwen36-35b",
  "small_model": "llama-at-home/qwen36-35b",
  "snapshot": false,
  "compaction": {
    "auto": true,
    "prune": true,
    "reserved": 8096
  },
  "tools": {
    "write": true,
    "read": true,
    "bash": true,
    "edit": true,
    "browser": false
  },
  "watcher": {
    "ignore": [
      "node_modules/**",
      "dist/**",
      "build/**",
      ".git/**",
      ".next/**",
      "venv/**",
      "env/**"
    ]
  },
  "autoupdate": false,
  "permission": {
    "bash": {
      "*": "ask",
      "git *": "deny",
      "npm *": "allow",
      "rm *": "deny",
      "grep *": "allow",
      "find *": "allow",
      "xargs *": "allow",
      "head *": "allow",
      "tail *": "allow",
      "cat *": "allow",
      "sed *": "allow",
      "ls *": "allow",
      "gradlew *": "allow",
      "adb *": "allow",
      "echo *": "allow",
      "curl *": "allow",
      "wget *": "allow",
      "sort *": "allow",
      "uniq *": "allow",
      "hexdump *": "allow",
      "mkdir *": "allow",
      "mv *": "allow",
      "wc *": "allow"
    },
    "edit": "allow",
    "write": "allow"
  },
  "mcp": {
    "chrome-devtools": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "chrome-devtools-mcp@latest"
      ]
    }
  }
}
