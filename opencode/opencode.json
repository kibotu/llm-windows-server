{
  "$schema": "https://opencode.ai/config.json",
  "provider": {
    "llama-at-home": {
      "name": "Kira",
      "npm": "@ai-sdk/openai-compatible",
      "options": {
        "baseURL": "http://127.0.0.1:8899/v1",
        "apiKey": "sk-REPLACE-WITH-LLAMA_API_KEY-FROM-DOTENV",
        "timeout": 300000,
        "chunkTimeout": 120000
      },
      "models": {
        "big": {
          "id": "/models/Qwen3.6-35B-A3B-UD-IQ4_XS.gguf",
          "name": "Big — Qwen3.6-35B-A3B IQ4_XS (vision, MoE)",
          "reasoning": true,
          "limit": {
            "context": 262144,
            "output": 8000
          }
        },
        "small": {
          "id": "/models/Qwen3.5-9B-Q4_K_M.gguf",
          "name": "Small — Qwen3.5-9B Q4_K_M (vision, dense)",
          "reasoning": true,
          "limit": {
            "context": 128000,
            "output": 6000
          }
        },
        "heretic": {
          "id": "/models/Qwen3.6-35B-A3B-Heretic-Cerebellum-14GB.gguf",
          "name": "Heretic — Qwen3.6-35B-A3B Cerebellum 14GB (vision, MoE)",
          "reasoning": true,
          "limit": {
            "context": 262144,
            "output": 8000
          }
        }
      }
    }
  },
  "model": "llama-at-home/big",
  "small_model": "llama-at-home/small",
  "snapshot": false,
  "compaction": {
    "auto": true,
    "prune": true,
    "reserved": 10240
  },
  "tools": {
    "write": true,
    "read": true,
    "bash": true,
    "edit": true,
    "browser": false
  },
  "watcher": {
    "ignore": [
      "node_modules/**",
      "dist/**",
      "build/**",
      ".next/**",
      ".nuxt/**",
      ".git/**",
      "venv/**",
      "env/**",

      "*.log",
      "coverage/**",

      ".cache/**",
      ".parcel-cache/**",
      ".webpack/**",
      ".vite/**",

      "Pods/**",
      "DerivedData/**",
      "**/*.xcworkspace/**",
      "**/*.xcodeproj/xcuserdata/**",
      "Carthage/Build/**",
      "fastlane/report.xml",

      ".gradle/**",
      "**/build/**",
      ".idea/**",
      "**/*.iml",
      "local.properties",
      "captures/**",
      "**/.cxx/**",

      "vendor/**",
      "var/cache/**",
      "storage/framework/**",
      "storage/logs/**",
      "bootstrap/cache/**",

      ".docker/**",
      "docker/volumes/**"
    ]
  },
  "autoupdate": false,
  "permission": {
    "bash": {
      "*": "ask",

      "ls *": "allow",
      "cat *": "allow",
      "head *": "allow",
      "tail *": "allow",
      "grep *": "allow",
      "rg *": "allow",
      "find *": "allow",
      "fd *": "allow",
      "xargs *": "allow",
      "wc *": "allow",
      "sort *": "allow",
      "uniq *": "allow",
      "hexdump *": "allow",
      "echo *": "allow",
      "pwd*": "allow",
      "which *": "allow",
      "type *": "allow",
      "diff *": "allow",
      "sed *": "allow",
      "tree*": "allow",
      "env": "allow",
      "printenv*": "allow",
      "date*": "allow",
      "whoami*": "allow",
      "uname*": "allow",

      "npm run *": "allow",
      "npm test*": "allow",
      "npx tsc*": "allow",
      "npx eslint*": "allow",
      "npx prettier*": "allow",
      "npm *": "allow",
      "npx *": "allow",
      "gradlew *": "allow",
      "adb *": "allow",
      "curl *": "allow",
      "wget *": "allow",
      "make*": "allow",
      "cargo build*": "allow",
      "cargo test*": "allow",
      "go build*": "allow",
      "go test*": "allow",
      "pytest*": "allow",
      "python -m pytest*": "allow",

      "mkdir *": "allow",
      "mv *": "allow",
      "touch *": "allow",
      "cp *": "allow",

      "git *": "ask",
      "git status*": "allow",
      "git diff*": "allow",
      "git log*": "allow",
      "git show*": "allow",
      "git branch*": "allow",
      "git blame*": "allow",
      "git remote*": "allow",
      "git fetch*": "allow",
      "git stash*": "allow",
      "git add *": "allow",
      "git restore *": "allow",

      "git commit*": "ask",
      "git push*": "ask",
      "git pull*": "ask",
      "git reset*": "ask",
      "git checkout *": "ask",
      "git merge*": "ask",
      "git rebase*": "ask",
      "git clean*": "ask",
      "git rm *": "ask",

      "rm *": "ask",
      "chmod *": "ask",
      "chown *": "ask",
      "sudo *": "ask",
      "dd *": "ask"
    },
    "edit": "allow",
    "write": "allow"
  },
  "mcp": {
    "llm-server": {
      "type": "http",
      "url": "http://127.0.0.1:8899/mcp",
      "enabled": true,
      "headers": {
        "Authorization": "Bearer sk-REPLACE-WITH-LLAMA_API_KEY-FROM-DOTENV"
      },
      "timeout": 660000
    },
    "chrome-devtools": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "chrome-devtools-mcp@latest"
      ]
    }
  }
}
