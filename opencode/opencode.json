{
  "$schema": "https://opencode.ai/config.json",
  "provider": {
    "llama-at-home": {
      "name": "Llama.cpp (RTX4080)",
      "npm": "@ai-sdk/openai-compatible",
      "options": {
        "baseURL": "http://1.2.3.4:8899/v1",
        "timeout": 180000,
        "chunkTimeout": 30000
      },
      "models": {
        "Qwen3.5-9B": {
          "name": "Qwen3.5-9B",
          "limit": {
            "context": 128000,
            "output": 6000
          }
        },
        "gemma-3-12b-it-Q4_K_M": {
          "name": "gemma-3-12b-it-Q4_K_M",
          "limit": {
            "context": 128000,
            "output": 8000
          }
        },
        "gemma-4-26B-A4B-it-UD-Q4_K_M": {
          "name": "gemma-4-26B-A4B-it-UD-Q4_K_M",
          "limit": {
            "context": 128000,
            "output": 8000
          }
        }
      }
    }
  },
  "model": "llama-at-home/Qwen3.5-9B",
  "small_model": "llama-at-home/Qwen3.5-9B",
  "snapshot": false,
  "compaction": {
    "auto": true,
    "prune": true,
    "reserved": 10000
  },
  "tools": {
    "write": true,
    "read": true,
    "bash": true,
    "edit": true,
    "browser": false
  },
  "watcher": {
    "ignore": [
      "node_modules/**",
      "dist/**",
      "build/**",
      ".git/**",
      ".next/**",
      "venv/**",
      "env/**"
    ]
  },
  "autoupdate": false,
  "permission": {
    "bash": {
      "deny": ["git"]
    },
    "edit": "allow",
    "write": "allow"
  }
}